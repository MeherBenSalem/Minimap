{
    "schemaVersion": 1,
    "id": "odysseymap",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": ["${mod_author}"],
    "contact": {
        "sources": "https://github.com/nightbeam/odysseymap"
    },
    "license": "${license}",
    "environment": "client",
    "entrypoints": {
        "client": ["dev.nightbeam.odysseymap.OdysseyMapFabric"]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17"
    }
}
